<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700;">Phân Ca Làm Việc Theo Ngày</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Gán ca làm việc cho nhân viên và theo dõi tiến độ điểm danh trong ngày.</p>
  </div>

  <form method="GET" action="/admin/assignments" style="display: flex; align-items: center; gap: 0.5rem; margin: 0;">
    <label for="date" class="form-label" style="margin: 0; white-space: nowrap;">Chọn Ngày:</label>
    <input type="date" id="date" name="date" value="<%= date %>" class="form-control" style="width: auto; padding: 0.45rem 0.75rem;">
    <button type="submit" class="btn btn-secondary btn-sm">Xem Lịch</button>
  </form>
</div>

<% if (success) { %>
  <div class="alert alert-success">
    <span>✅ <%= success %></span>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-error">
    <span>⚠️ <%= error %></span>
  </div>
<% } %>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; align-items: start;">
  <!-- Form gán ca làm việc -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Phân Ca Mới</h2>
    </div>

    <form action="/admin/assignments" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="assigned_date" class="form-label">Ngày phân công</label>
        <input 
          type="date" 
          id="assigned_date" 
          name="assigned_date" 
          value="<%= date %>" 
          class="form-control" 
          required
        >
      </div>

      <div class="form-group">
        <label for="user_id" class="form-label">Chọn nhân viên</label>
        <select id="user_id" name="user_id" class="form-control" required>
          <option value="">-- Chọn nhân viên --</option>
          <% staffList.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.full_name %> (<%= s.username %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="shift_id" class="form-label">Chọn ca làm</label>
        <select id="shift_id" name="shift_id" class="form-control" required>
          <option value="">-- Chọn ca làm việc --</option>
          <% shiftList.forEach(function(sh) { %>
            <option value="<%= sh.id %>"><%= sh.name %> (<%= sh.start_time.slice(0, 5) %> - <%= sh.end_time.slice(0, 5) %>)</option>
          <% }); %>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem;">
        + Xác Nhận Phân Ca
      </button>
    </form>
  </div>

  <!-- Danh sách phân ca trong ngày được chọn -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Lịch Phân Ca Ngày <%= date %> (<%= assignments.length %> lượt)</h2>
    </div>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Nhân Viên</th>
            <th>Ca Làm</th>
            <th>Giờ Vào</th>
            <th>Giờ Ra</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          <% if (assignments.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                Chưa có phân ca nào trong ngày <%= date %>.
              </td>
            </tr>
          <% } else { %>
            <% assignments.forEach(function(a) { %>
              <tr>
                <td>
                  <strong><%= a.full_name %></strong><br>
                  <small style="color: var(--text-muted);"><code><%= a.username %></code></small>
                </td>
                <td>
                  <%= a.shift_name %><br>
                  <small style="color: var(--text-muted);"><%= a.start_time.slice(0, 5) %> - <%= a.end_time.slice(0, 5) %></small>
                </td>
                <td><%= a.check_in ? a.check_in.slice(11, 19) : '<span style="color: var(--text-muted);">Chưa check-in</span>' %></td>
                <td><%= a.check_out ? a.check_out.slice(11, 19) : '<span style="color: var(--text-muted);">Chưa check-out</span>' %></td>
                <td>
                  <% if (!a.check_in) { %>
                    <span class="badge" style="background: #f1f5f9; color: #475569;">Chưa điểm danh</span>
                  <% } else if (a.status === 'on_time') { %>
                    <span class="badge badge-on_time">Đúng giờ</span>
                  <% } else { %>
                    <span class="badge badge-late">Đi muộn</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
