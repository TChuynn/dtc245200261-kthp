# Cổng dịch vụ Nginx trên máy host
APP_PORT=80
APP_PORT_SSL=443
PMA_PORT=8081

# Môi trường ứng dụng Node.js
NODE_ENV=production
PORT=3000
SESSION_SECRET=sinh_chuoi_ngau_nhien_cho_session_secret
TZ=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu MySQL 8.4 LTS
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=quan_ly_diem_danh
MYSQL_USER=diemdanh_app
MYSQL_PASSWORD=mat_khau_user_ung_dung
MYSQL_ROOT_PASSWORD=mat_khau_root_quan_tri

# Mật khẩu khởi tạo mẫu (Seed data)
SEED_ADMIN_PASSWORD=mat_khau_admin_khoi_tao
SEED_STAFF_PASSWORD=mat_khau_staff_khoi_tao

# Giám sát hệ thống (Prometheus & Grafana)
MYSQL_EXPORTER_PASSWORD=mat_khau_user_mysqld_exporter
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=mat_khau_admin_grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
