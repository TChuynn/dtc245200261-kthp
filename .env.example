# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG AN TOÀN
# Để sinh chuỗi bí mật ngẫu nhiên và mật khẩu mạnh, chạy lệnh:
#   openssl rand -base64 24
# Lưu ý: Ứng dụng sẽ từ chối khởi động nếu SEED_ADMIN_PASSWORD sử dụng giá trị mẫu
# hoặc không đạt độ dài tối thiểu 12 ký tự (gồm chữ hoa, chữ thường, số, ký tự đặc biệt).
# ==============================================================================

# Cổng dịch vụ Nginx trên máy host
APP_PORT=80
APP_PORT_SSL=443
PMA_PORT=8081

# Môi trường ứng dụng Node.js
NODE_ENV=production
PORT=3000
# Sinh bằng: openssl rand -base64 24
SESSION_SECRET=sinh_chuoi_ngau_nhien_cho_session_secret
TZ=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu MySQL 8.4 LTS
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=quan_ly_diem_danh
MYSQL_USER=diemdanh_app
# Sinh bằng: openssl rand -base64 24
MYSQL_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24
MYSQL_ROOT_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24

# Mật khẩu khởi tạo mẫu (Seed data)
# Sinh bằng: openssl rand -base64 24 (App kiểm tra tính an toàn khi khởi động)
SEED_ADMIN_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24
SEED_STAFF_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24

# Giám sát hệ thống (Prometheus & Grafana)
MYSQL_EXPORTER_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=sinh_bang_lenh_openssl_rand_base64_24
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
